# Code Atlas 配置。密钥可写在 [llm].api_key，或用环境变量（环境变量优先）。
# OPENAI_API_KEY / ANTHROPIC_API_KEY / ATLAS_PROVIDER / ATLAS_MODEL
# 此文件可提交；本地真实配置 atlas.toml / atlas.config.json 已在 .gitignore。

[llm]
provider = "openai-compatible"
model = "qwen2.5-coder:32b"
# 可选：直接写密钥。远程 OpenAI 兼容 / Anthropic 需要；本机 Ollama 可留空。
api_key = ""
base_url = "http://127.0.0.1:11434/v1"
temperature = 0.2
max_output_tokens = 16384
concurrency = 5
timeout_secs = 180
retries = 3
# 提示词按「稳定前缀在前」组织，用来命中供应商的 prompt cache（省费用，不改输出）：
#   ① 系统提示跨页逐字节一致（角色 + 风格 + 禁用格式，不含任何页级内容）
#   ② 消息体开头是仓库共享证据（仓库地图 / 声明依赖 / 真实命令 / 模块 / wiki 目录）
#   ③ 页级内容（本页范围、符号骨架、写作要求）排在最后
#   ④ 深度重写的请求 = 首稿的 system + user 原样前缀，再追加「缺口 + 草稿」
# 支持缓存的供应商（OpenAI / DeepSeek / StepFun 等）按未命中部分计费；汇总行
# 「提示词缓存：X/Y prompt tokens 命中」直接给出命中率，run notes 里是 `prompt cache:`。
# 把用量写进平台账单前请先用该行确认命中率——是否缓存由供应商决定，atlas 只保证前缀稳定。
# 工具侧另有两项省 token 的机制（默认开启、无需配置）：
#   ① 文件快照：read_file 每个文件一次运行只读一次盘，之后任意行范围都用快照切片；
#   ② 输出压缩管道：空白归一 / 空行折叠 / 公共缩进外提 / 重复行折叠（后两者精确可逆），
#      作用在喂给模型的文本上，不改仓库文件；汇总行报「工具输出压缩：省下 N 字符」。
# 读取预算：每页 max_tool_rounds × 3 次「只读不写」的 read_file/list_files/grep。
# 按**调用次数**而不是「轮」计——模型常一轮只要一个文件，按轮算会让它读不够就被迫开写。
# **边写边读的调用不计费**：流式模型一边写页面一边读文件，那种调用在推进页面，
# 掐掉它只会把页面截在半句话上；它们只受每页 max_tool_rounds × 3 × 4 次调用上限约束。
# 预算用尽后模型仍要文件时，会收到「预算已用尽，直接写正文」的回答并再问两次，然后收尾。
# 0 表示完全不给工具（纯证据生成）。每次调用都是一轮完整模型调用（重发整个对话）。
max_tool_rounds = 2
# Re-check each page against the depth bar and let the model expand it once when it is too thin.
depth_pass = true

[privacy]
redact_paths = ["**/.env", "**/*.pem", "**/id_rsa*", "**/credentials*.json"]
max_file_bytes = 262144

[graph]
llm_extract = true
max_neighborhood_depth = 3
authoritative_min_confidence = 0.7

[kb]
search = "fts5"
embed_model = ""
max_context_bytes = 24576

[kb.chunk]
mode = "hybrid"
target_tokens = 512
chunk_model = ""

[output]
strategy = "in-repo"
atlas_root = "atlas"
external_root = ""
language = "zh-CN"

[analyze]
languages = ["rust", "typescript", "javascript", "python"]
